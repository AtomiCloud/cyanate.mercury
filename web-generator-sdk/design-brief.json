  "designDirection": {
    "overall": "Modern, professional healthcare website with Vercel-inspired clean aesthetics. Emphasizes trust, expertise, and patient-centered care through generous whitespace, clear typography hierarchy, and a calming blue primary color palette.",
    "colorStrategy": {
      "primary": "Blue (oklch(0.470 0.113 264.0)) - conveys trust, professionalism, and medical expertise",
      "background": "Near-white (oklch(0.983 0.000 158.2)) - clean, clinical feel",
      "accent": "Same blue as primary for CTAs and highlights",
      "muted": "Subtle gray (oklch(0.970 0.003 264.0)) for section backgrounds",
      "usage": "High contrast for accessibility (foreground 0.000, background 0.983), blue accents for trust and professionalism in healthcare context"
    },
    "typography": {
      "heading": "Geist font, semibold (600), tight tracking for modern feel",
      "body": "Geist font, normal (400), comfortable line-height for readability",
      "sizes": "48px for hero h1, 32px for section h2, 14-20px for body text",
      "approach": "Clear hierarchy with generous spacing for medical content readability"
    },
    "spacing": {
      "sectionPadding": "py-16 to py-20 (64-80px vertical padding)",
      "contentWidth": "max-w-7xl for full sections, max-w-4xl for focused content",
      "gridGap": "gap-6 to gap-8 (24-32px)",
      "philosophy": "Generous whitespace creates calm, professional healthcare atmosphere"
    },
    "borderRadius": {
      "cards": "xl (8px) for subtle, professional appearance",
      "buttons": "lg (64px) for pill-shaped modern CTAs",
      "images": "md (12px top) for consistent framing"
    },
    "shadows": {
      "cards": "Multi-layered subtle shadows (lg) for depth without heavy feel",
      "buttons": "Minimal shadow on hover",
      "philosophy": "Subtle depth enhances trust and premium feel"
    },
    "interaction": {
      "hover": "Subtle lift on cards, color shift on links",
      "focus": "Visible ring state (oklch(0.556 0.400 285.2)) for accessibility",
      "transitions": "Fast (150-200ms) for responsive feel"
    }

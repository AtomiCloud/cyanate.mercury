---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Welcome">
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-heading">Welcome to Your Generated Site</h1>
        <p class="hero-subheading">This is a placeholder page that will be replaced during generation.</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-heading {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: hsl(var(--foreground));
  }

  .hero-subheading {
    font-size: 1.25rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 768px) {
    .hero-heading {
      font-size: 2rem;
    }
    .hero-subheading {
      font-size: 1rem;
    }
  }
</style>

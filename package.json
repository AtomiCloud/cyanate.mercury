{
	"name": "mecury",
	"version": "0.1.0",
	"description": "AI-powered website regeneration engine — generates Astro.js sites from scraped content using a reference site's design",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "bun src/index.ts",
		"start": "bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write --unsafe src/",
		"check": "biome check src/ && tsc --noEmit && knip",
		"knip": "knip",
		"build": "tsc --declaration --outDir dist"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.92",
		"@inquirer/prompts": "^8.4.0",
		"@playwright/test": "^1.59.1",
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"culori": "^4.0.2",
		"yaml": "^2.8.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/bun": "latest",
		"@types/node": "^25.5.2",
		"knip": "^5.88.1",
		"typescript": "^6.0.2"
	}
}

		"tw-animate-css": "^1.3.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.7",
		"@biomejs/biome": "2.4.7",
		"@tailwindcss/postcss": "^4.2.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"knip": "^5.86.0",
		"typescript": "^5.9.3"
